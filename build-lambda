#!/usr/bin/env python3
"""
build-lambda -- canonical build-time step for Onedata Automation lambdas (lambda-base v3).

Invoked from a lambda's Dockerfile inside the build environment that lambda-base provides.
It encapsulates ALL build-time logic so per-lambda Dockerfiles never see uv flags, venv
paths, or the privilege transition.

Canonical Dockerfile contract (what build-lambda expects):
```
# syntax=docker/dockerfile:1.7
FROM onedata/lambda-base-slim:v3
ARG LAMBDA_PACKAGE=
USER root
RUN --mount=type=cache,target=/home/app/.cache/uv \\
    --mount=type=bind,source=.,target=/build \\
    build-lambda "$LAMBDA_PACKAGE"
USER app
```
- The build context (repo root) is bind-mounted read-only at /build.
- The uv cache is bind-mounted at /home/app/.cache/uv.
- UV_PROJECT_ENVIRONMENT (set by the base) points at the venv to populate.
- $LAMBDA_PACKAGE (optional, may be empty) is the uv workspace member to build;
  empty/absent => single-lambda repo (the build-context root IS the package).

What it does (build mode, must run as root):
  1. Resolve the target lambda package's pyproject.toml (root, or the workspace member
     whose [project].name matches the given package).
  2. HARD-validate that the package declares exactly one `onedata.lambda` entry point.
  3. HARD-require that the SDK (onedata-lambda-utils) is a declared dependency; fail if not
     (the runtime contract lives in the SDK, so every built image must ship it).
  4. Install declared system packages from `[tool.onedata.lambda] system-packages` via apt.
  5. `uv sync --frozen --no-dev --no-editable [--package <name>]`, dropped to the
     unprivileged `app` user via gosu so the resulting venv is owned by `app`.

Privilege model (gosu): apt needs root and the venv must end up app-owned. The canonical
template elevates with `USER root` for the build step; build-lambda apts as root, then
`gosu app` for `uv sync`, and the template restores `USER app` for the runtime container.

Dev-time mode:
  build-lambda --fix [PACKAGE]   add the missing SDK dependency via `uv add` (writable
                                 checkout; does NOT require root and does not build).
"""

__author__ = "Bartosz Walkowicz"
__copyright__ = "Copyright (C) 2026 Onedata (onedata.org)"
__license__ = "This software is released under the MIT license cited in LICENSE.txt"

import argparse
import os
import subprocess
import sys
import tomllib
from pathlib import Path

APP_USER = "app"
APP_HOME = Path("/home/app")
UV_CACHE_DIR = Path(os.environ.get("UV_CACHE_DIR") or APP_HOME / ".cache" / "uv")
ENTRY_POINT_GROUP = "onedata.lambda"
SDK_DIST = "onedata-lambda-utils"


def main() -> None:
    parser = argparse.ArgumentParser(prog="build-lambda")
    parser.add_argument(
        "package",
        nargs="?",
        default="",
        help="uv workspace member to build (empty for a single-lambda repo)",
    )
    parser.add_argument(
        "--fix",
        action="store_true",
        help="dev-time: add the missing SDK dependency via `uv add` and exit",
    )
    args = parser.parse_args()
    package = args.package or None

    root = build_root()
    package_dir = resolve_package_dir(root, package)
    pyproject = load_pyproject(package_dir / "pyproject.toml")

    validate_entry_point(pyproject)

    sdk_present = has_sdk(pyproject)

    if args.fix:
        if sdk_present:
            info(f"{SDK_DIST} already declared; nothing to fix")
        else:
            fix_sdk(package_dir)
        return

    if not sdk_present:
        die(
            f"{SDK_DIST} is required but is not a declared dependency. Add it with "
            f"`build-lambda --fix`, or declare it in pyproject.toml "
            f'(dependencies = ["{SDK_DIST}>=0.4"]).'
        )

    require_root()
    install_system_packages(pyproject)
    uv_sync(root, package)
    info("done")


def build_root() -> Path:
    """The build context root: /build inside the image, else the current directory."""
    bind = Path("/build")
    if (bind / "pyproject.toml").is_file():
        return bind

    return Path.cwd()


def resolve_package_dir(root: Path, package) -> Path:
    """Directory of the target lambda package (root for single-lambda, else the member)."""
    if not package:
        return root

    root_pp = load_pyproject(root / "pyproject.toml")
    members = root_pp.get("tool", {}).get("uv", {}).get("workspace", {}).get("members", [])
    if not members:
        die(
            f"--package {package!r} given but root pyproject declares no "
            f"[tool.uv.workspace] members"
        )

    for pattern in members:
        for member_dir in sorted(root.glob(pattern)):
            member_pp = member_dir / "pyproject.toml"
            if not member_pp.is_file():
                continue
            if load_pyproject(member_pp).get("project", {}).get("name") == package:
                return member_dir

    die(f"workspace member {package!r} not found among members {members}")


def load_pyproject(path: Path) -> dict:
    try:
        with open(path, "rb") as f:
            return tomllib.load(f)
    except FileNotFoundError:
        die(f"no pyproject.toml at {path}")
    except tomllib.TOMLDecodeError as e:
        die(f"invalid pyproject.toml at {path}: {e}")


def validate_entry_point(pyproject: dict) -> None:
    entry_points = pyproject.get("project", {}).get("entry-points", {}).get(ENTRY_POINT_GROUP, {})
    if len(entry_points) == 0:
        die(
            f'no [project.entry-points."{ENTRY_POINT_GROUP}"] declared; a lambda must '
            f"declare exactly one entry point"
        )
    if len(entry_points) > 1:
        die(
            f"multiple {ENTRY_POINT_GROUP} entry points declared "
            f"({', '.join(entry_points)}); exactly one expected"
        )

    name, target = next(iter(entry_points.items()))
    info(f"entry point: {name} = {target}")


def has_sdk(pyproject: dict) -> bool:
    for dep in pyproject.get("project", {}).get("dependencies", []):
        head = dep.split(";")[0].strip()
        for sep in ("===", "==", ">=", "<=", "~=", "!=", ">", "<", "[", " "):
            head = head.split(sep)[0]
        if head.strip().lower().replace("_", "-") == SDK_DIST:
            return True

    return False


def fix_sdk(package_dir: Path) -> None:
    info(f"--fix: adding {SDK_DIST} via `uv add`")
    run(["uv", "add", SDK_DIST], cwd=package_dir)


def require_root() -> None:
    if os.geteuid() != 0:
        die(
            "build-lambda must run as root so it can install system packages and set venv "
            "ownership. Add `USER root` before `RUN build-lambda` in the Dockerfile (and "
            "`USER app` after). The onedata-lambda CLI generates this template for you."
        )


def install_system_packages(pyproject: dict) -> None:
    pkgs = pyproject.get("tool", {}).get("onedata", {}).get("lambda", {}).get("system-packages", [])
    if not pkgs:
        return

    info(f"installing system packages: {' '.join(pkgs)}")
    run(["apt-get", "update"])
    run(["apt-get", "install", "-y", "--no-install-recommends", *pkgs])
    run(["sh", "-c", "rm -rf /var/lib/apt/lists/*"])


def uv_sync(root: Path, package) -> None:
    cmd = ["uv", "sync", "--frozen", "--no-dev", "--no-editable"]
    if package:
        cmd += ["--package", package]

    # Make the (root-created) cache mount writable by app, then drop privileges so the
    # venv at UV_PROJECT_ENVIRONMENT is owned by app.
    UV_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    run(["chown", f"{APP_USER}:{APP_USER}", str(UV_CACHE_DIR)])

    cmd = ["gosu", APP_USER, "env", f"HOME={APP_HOME}", *cmd]
    info(f"running: {' '.join(cmd)} (cwd={root})")
    run(cmd, cwd=root)


def run(cmd: list, cwd=None) -> None:
    try:
        subprocess.run(cmd, cwd=cwd, check=True)
    except subprocess.CalledProcessError as e:
        die(
            f"command failed (exit {e.returncode}): {' '.join(map(str, cmd))}",
            code=e.returncode,
        )
    except FileNotFoundError:
        die(f"command not found: {cmd[0]}")


def info(msg: str) -> None:
    print(f"build-lambda: {msg}", file=sys.stderr)


def die(msg: str, code: int = 1) -> "None":
    print(f"build-lambda: error: {msg}", file=sys.stderr)
    sys.exit(code)


if __name__ == "__main__":
    main()
